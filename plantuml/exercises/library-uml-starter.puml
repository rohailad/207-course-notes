@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

interface Borrowable {
  + borrow(member : Member) : void
  + getLoanPeriodWeeks() : int
}

class Book {
  - loanPeriodWeeks : int
  + borrow(member : Member) : void
  + getLoanPeriodWeeks() : int
}

class DVD {
  - loanPeriodWeeks : int
  + borrow(member : Member) : void
  + getLoanPeriodWeeks() : int
}

class ReferenceItem {
  + isReferenceOnly() : boolean
}

abstract class Person {
  - name : String
}

class Member {
  - memberNumber : String
  + login(memberNumber : String) : boolean
  + placeHold(item : Item) : Hold
}

class Librarian {
  + addItem(item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Hold {
  - member : Member
  - item : Item
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceItem

Borrowable <|.. Book
Borrowable <|.. DVD

Person <|-- Member
Person <|-- Librarian

Member "1" --> "0..*" Hold : places
Hold --> Item : reserves
Librarian --> Item : adds
Librarian --> Member : waives fees for

@enduml
